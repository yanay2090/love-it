# Copy the EXPO_PUBLIC_* lines to apps/mobile/.env
# Copy the NEXT_PUBLIC_* lines to apps/web/.env.local
# The app runs with none of these set. Tel Aviv seed data covers search,
# profiles, and the public pages. Analytics calls no-op until a PostHog key exists.

# --- iPhone app (apps/mobile/.env) ---
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_WEB_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Maps token from Apple Maps Server API (developer.apple.com). Optional.
# Map tiles on iOS use MapKit through react-native-maps and do not need this.
EXPO_PUBLIC_APPLE_MAPS_TOKEN=

# --- Public web (apps/web/.env.local) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
