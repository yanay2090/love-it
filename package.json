{
  "name": "love-it",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "tsx packages/shared/src/selfcheck.ts",
    "dev:web": "npm run dev -w @love-it/web",
    "build:web": "npm run build -w @love-it/web",
    "dev:mobile": "npm run start -w @love-it/mobile",
    "ios": "npm run ios -w @love-it/mobile",
    "supabase:smoke": "tsx scripts/supabase-smoke-test.ts"
  },
  "devDependencies": {
    "tsx": "^4.20.5",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
