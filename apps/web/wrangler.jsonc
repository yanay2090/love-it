{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loveitapp",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Both hostnames hit this Worker. www redirects to the apex in next.config.ts.
  "routes": [
    { "pattern": "loveitapp.com", "custom_domain": true },
    { "pattern": "www.loveitapp.com", "custom_domain": true }
  ]
  // Worker variables (Cloudflare dashboard → loveitapp → Settings → Variables and secrets).
  // Next inlines NEXT_PUBLIC_* at build time, so set the same values in the shell
  // or in apps/web/.env.production before `npm run deploy`:
  //   NEXT_PUBLIC_LAUNCH_MODE=placeholder
  //   NEXT_PUBLIC_SUPABASE_URL
  //   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY   (sb_publishable_... — never an sb_secret_ key)
  //   NEXT_PUBLIC_SITE_URL=https://loveitapp.com
}
